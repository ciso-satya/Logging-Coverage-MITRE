    {"pattern": "unified ?log|macos|mac[-_ ]?os|osx|\\bmac\\b|darwin", "mitre_log_sources": ["macos:unifiedlog", "macOS:unifiedlog", "macos:syslog", "macos:auth", "macos:launchd", "macos:keychain", "macos:fsevents", "fs:fsevents", "fs:fsusage", "fs:plist", "fs:launchdaemons"], "note": "macOS unified log"},
