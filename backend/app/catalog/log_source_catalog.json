{
  "_comment": "Built-in mapping of SIEM / pipeline log source identifiers (Splunk sourcetypes, CrowdStrike NG-SIEM vendors/products/event types, Cribl input types, generic product names) to MITRE ATT&CK canonical log source names as used by ATT&CK v18+ Analytics. Patterns are case-insensitive regular expressions matched against the log source name, vendor, product and kind. Users can add overrides from the Settings page.",
  "entries": [
    {"pattern": "(xml)?wineventlog:security|microsoft-windows-security-auditing|windows.*security.*(event|log)|win(dows)?[-_ ]?security|event\\.provider.*security-auditing|securityevent|\\bsecurity\\b.*\\b(4624|4688)\\b", "mitre_log_sources": ["WinEventLog:Security", "etw:Microsoft-Windows-Security-Auditing"], "note": "Windows Security event log"},
    {"pattern": "sysmon", "mitre_log_sources": ["WinEventLog:Sysmon"], "note": "Sysmon (Windows)"},
    {"pattern": "(xml)?wineventlog:system$|microsoft-windows-system|windows.*system.*(event|log)|win[-_ ]?system", "mitre_log_sources": ["WinEventLog:System"], "note": "Windows System event log"},
    {"pattern": "(xml)?wineventlog:application$|windows.*application.*(event|log)|win[-_ ]?application", "mitre_log_sources": ["WinEventLog:Application", "Application Log"], "note": "Windows Application event log"},
    {"pattern": "powershell", "mitre_log_sources": ["WinEventLog:PowerShell", "EDR:scriptblock"], "note": "PowerShell operational / script block logging"},
    {"pattern": "wineventlog:.*wmi|wmi-activity|\\bwmi\\b", "mitre_log_sources": ["WinEventLog:WMI"], "note": "WMI activity log"},
    {"pattern": "taskscheduler|task[-_ ]?scheduler", "mitre_log_sources": ["WinEventLog:TaskScheduler"], "note": "Scheduled task log"},
    {"pattern": "winrm|windows remote management", "mitre_log_sources": ["WinEventLog:WinRM"], "note": "WinRM"},
    {"pattern": "applocker", "mitre_log_sources": ["WinEventLog:AppLocker"], "note": "AppLocker"},
    {"pattern": "codeintegrity|code[-_ ]integrity", "mitre_log_sources": ["WinEventLog:CodeIntegrity", "WinEventLog:Microsoft-Windows-CodeIntegrity/Operational"], "note": "Code Integrity"},
    {"pattern": "windows ?defender|microsoft-windows-windows defender|defender/operational|windefend", "mitre_log_sources": ["WinEventLog:Windows Defender", "WinEventLog:Microsoft-Windows-Windows Defender/Operational"], "note": "Microsoft Defender Antivirus"},
    {"pattern": "defender.*(advancedhunting|device(process|network|file|registry|logon|event)|atp)|microsoft 365 defender|m365defender|mde", "mitre_log_sources": ["M365Defender:DeviceNetworkEvents", "m365:defender", "EDR:Telemetry", "EDR:detection", "EDR:file", "EDR:cli", "WinEventLog:Sysmon", "WinEventLog:Security"], "note": "Microsoft Defender for Endpoint / XDR advanced hunting"},
    {"pattern": "firewall with advanced security|windows[-_ ]?firewall|pfirewall", "mitre_log_sources": ["WinEventLog:Microsoft-Windows-Windows Firewall With Advanced Security/Firewall", "Windows Firewall Log", "NSM:Firewall"], "note": "Windows Firewall"},
    {"pattern": "adfs|active directory federation", "mitre_log_sources": ["WinEventLog:ADFS"], "note": "AD FS"},
    {"pattern": "kerberos", "mitre_log_sources": ["WinEventLog:Kerberos", "WinEventLog:Security"], "note": "Kerberos"},
    {"pattern": "smbclient|smb[-_ ]?client", "mitre_log_sources": ["WinEventLog:Microsoft-Windows-SMBClient/Security"], "note": "SMB client"},
    {"pattern": "microsoft-windows-tcpip|tcpip/operational", "mitre_log_sources": ["WinEventLog:Microsoft-Windows-TCPIP"], "note": "TCP/IP"},
    {"pattern": "microsoft-windows-vss|volume shadow", "mitre_log_sources": ["WinEventLog:Microsoft-Windows-VSS"], "note": "VSS"},
    {"pattern": "windows-backup|microsoft-windows-backup", "mitre_log_sources": ["WinEventLog:Microsoft-Windows-Backup"], "note": "Windows Backup"},
    {"pattern": "wlan-autoconfig|wlan", "mitre_log_sources": ["WinEventLog:Microsoft-Windows-WLAN-AutoConfig", "WLANLogs:Association"], "note": "WLAN"},
    {"pattern": "shell-core", "mitre_log_sources": ["WinEventLog:Microsoft-Windows-Shell-Core"], "note": "Shell-Core"},
    {"pattern": "kernel-boot", "mitre_log_sources": ["WinEventLog:Microsoft-Windows-Kernel-Boot"], "note": "Kernel boot"},
    {"pattern": "iis|w3c|inetinfo", "mitre_log_sources": ["WinEventLog:iis", "ApplicationLog:IIS", "ApplicationLog:WebServer"], "note": "IIS"},
    {"pattern": "\\bdhcp\\b", "mitre_log_sources": ["wineventlog:dhcp"], "note": "DHCP server log"},
    {"pattern": "\\betw\\b|event tracing|kernel-process|kernel-file|silketw|sealighter", "mitre_log_sources": ["ETW", "etw:Microsoft-Windows-Kernel-Process", "etw:Microsoft-Windows-Kernel-File", "ETW:ProcThread"], "note": "Windows ETW providers"},
    {"pattern": "\\bamsi\\b|antimalware-scan-interface", "mitre_log_sources": ["EDR:AMSI", "etw:Microsoft-Antimalware-Scan-Interface"], "note": "AMSI"},
    {"pattern": "autoruns", "mitre_log_sources": ["Autoruns:RegistryScan"], "note": "Autoruns"},
    {"pattern": "perfmon|performance counter", "mitre_log_sources": ["Windows:perfmon"], "note": "Perfmon"},
    {"pattern": "osquery", "mitre_log_sources": ["linux:osquery", "macos:osquery", "windows:osquery", "containers:osquery"], "note": "osquery (all platforms)"},

    {"pattern": "crowdstrike|falcon|fdr|processrollup|event_simplename|\\bcs:", "mitre_log_sources": ["EDR:Telemetry", "EDR:detection", "EDR:file", "EDR:cli", "EDR:memory", "EDR:hunting", "WinEventLog:Sysmon", "WinEventLog:Security", "WinEventLog:PowerShell", "NSM:Flow", "NSM:Connections", "auditd:SYSCALL", "auditd:EXECVE", "macos:endpointsecurity", "linux:Sysmon"], "note": "CrowdStrike Falcon sensor telemetry (FDR / NG-SIEM) covers process, file, network, script and memory telemetry across OSes"},
    {"pattern": "sentinelone|sentinel[-_ ]one|\\bs1\\b|carbon ?black|cb[-_ ]?(response|defense|edr)|cylance|cortex xdr|tanium|elastic[-_ ]?(agent|endpoint)|microsoft defender for endpoint|\\bedr\\b", "mitre_log_sources": ["EDR:Telemetry", "EDR:detection", "EDR:file", "EDR:cli", "EDR:memory", "EDR:hunting", "WinEventLog:Sysmon", "WinEventLog:Security", "auditd:SYSCALL", "macos:endpointsecurity"], "note": "Generic EDR telemetry"},

    {"pattern": "auditd|linux[-_ ]?audit|\\baudit\\.log|audispd", "mitre_log_sources": ["auditd:SYSCALL", "auditd:EXECVE", "auditd:PATH", "auditd:FILE", "auditd:PROCTITLE", "auditd:CONFIG_CHANGE", "auditd:USER_LOGIN", "auditd:AUTH", "auditd:DAEMON", "auditd:FS", "auditd:MMAP", "auditd:file-events", "auditd:memprotect"], "note": "Linux auditd"},
