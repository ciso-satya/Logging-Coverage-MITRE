    {"pattern": "\\bebpf\\b|falco|tracee|tetragon|cilium", "mitre_log_sources": ["ebpf:syscalls", "ebpf:tracepoints", "auditd:SYSCALL", "containers:osquery", "containerd:runtime"], "note": "eBPF runtime security"},
    {"pattern": "\\bfim\\b|file integrity|aide|tripwire|wazuh.*syscheck|inotify", "mitre_log_sources": ["linux:fim", "fs:fileevents", "fs:filesystem", "auditd:FILE"], "note": "File integrity monitoring"},
    {"pattern": "procfs|/proc/", "mitre_log_sources": ["linux:procfs"], "note": "procfs"},
