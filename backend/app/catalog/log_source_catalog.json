    {"pattern": "^syslog$|linux[-_ ]?(messages|syslog)|/var/log/messages|rsyslog|syslog-ng|\\bsyslog\\b", "mitre_log_sources": ["linux:syslog", "macos:syslog", "esxi:syslog", "networkdevice:syslog", "snmp:syslog"], "note": "Generic syslog"},
