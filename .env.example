# Copy to .env and adjust. All variables are optional.

# Host/port for the API server
LCM_HOST=0.0.0.0
LCM_PORT=8000

# Directory for the SQLite database, cached ATT&CK bundle and secret key
LCM_DATA_DIR=./data

# Fernet key used to encrypt connector credentials at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is generated on first start and stored in $LCM_DATA_DIR/.secret_key
LCM_SECRET_KEY=

# ATT&CK STIX bundle source (MITRE's official GitHub repo)
LCM_ATTACK_STIX_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json

# Automatically sync all enabled connections every N minutes (0 = disabled)
LCM_SYNC_INTERVAL_MINUTES=0

# Load the built-in demo connection on first start (true/false)
LCM_SEED_DEMO=true
